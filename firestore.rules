rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Products: public read, only authenticated admin can create, update, delete
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Categories: public read, only authenticated admin can write
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Settings: public read, only authenticated admin can update
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Orders: public customer checkout, only authenticated admin can view, process, delete
    match /orders/{orderId} {
      allow create: if isValidId(orderId) 
        && request.resource.data.customerName is string
        && request.resource.data.totalAmount is number;
      allow read, update, delete: if isSignedIn();
    }

    // Admins registry: only authenticated users can check or register their admin profile
    match /admins/{adminId} {
      allow read, write: if isSignedIn();
    }
  }
}
